import Std

namespace Composed

-- Untrusted numeric witnesses. Denominator positivity is checked, never assumed.
structure Q where
  n : Int
  d : Nat
  deriving Repr
structure Box where
  lo : Q
  hi : Q
  deriving Repr
def le (a b : Q) : Bool := a.n * b.d ≤ b.n * a.d
def lt (a b : Q) : Bool := a.n * b.d < b.n * a.d
def eq (a b : Q) : Bool := a.n * b.d == b.n * a.d
def zero : Q := ⟨0, 1⟩
def one : Q := ⟨1, 1⟩
def add (a b : Q) : Q := ⟨a.n * b.d + b.n * a.d, a.d * b.d⟩
def neg (a : Q) : Q := ⟨-a.n, a.d⟩
def sub (a b : Q) : Q := add a (neg b)
def mul (a b : Q) : Q := ⟨a.n * b.n, a.d * b.d⟩
def div (a b : Q) : Q :=
  if b.n < 0 then ⟨-a.n * b.d, a.d * b.n.natAbs⟩
  else ⟨a.n * b.d, a.d * b.n.natAbs⟩
def valid (a : Box) : Bool := a.lo.d > 0 && a.hi.d > 0 && le a.lo a.hi
def contains (r : Box) (a : Q) : Bool := le r.lo a && le a r.hi
def singleton (r : Box) (a : Q) : Bool := eq r.lo a && eq r.hi a

inductive Op where
  | constant (q : Q)
  | add | sub | mul | div | min | max | floor | lt | le | eq | truth | neg
  deriving Repr
structure Constraint where
  op : Op
  a : Box
  b : Box
  result : Box
  deriving Repr

def check (c : Constraint) : Bool :=
  valid c.a && valid c.b && valid c.result &&
  match c.op with
  | .constant q => q.d > 0 && singleton c.result q
  | .add => le c.result.lo (add c.a.lo c.b.lo) && le (add c.a.hi c.b.hi) c.result.hi
  | .sub => le c.result.lo (sub c.a.lo c.b.hi) && le (sub c.a.hi c.b.lo) c.result.hi
  | .neg => le c.result.lo (neg c.a.hi) && le (neg c.a.lo) c.result.hi
  | .mul => [mul c.a.lo c.b.lo, mul c.a.lo c.b.hi, mul c.a.hi c.b.lo, mul c.a.hi c.b.hi].all (contains c.result)
  | .div => (lt c.b.hi zero || lt zero c.b.lo) &&
      [div c.a.lo c.b.lo, div c.a.lo c.b.hi, div c.a.hi c.b.lo, div c.a.hi c.b.hi].all (contains c.result)
  | .min => le c.result.lo (if le c.a.lo c.b.lo then c.a.lo else c.b.lo) &&
      le (if le c.a.hi c.b.hi then c.a.hi else c.b.hi) c.result.hi
  | .max => le c.result.lo (if le c.a.lo c.b.lo then c.b.lo else c.a.lo) &&
      le (if le c.a.hi c.b.hi then c.b.hi else c.a.hi) c.result.hi
  | .floor => singleton c.result ⟨c.a.lo.n / (Int.ofNat c.a.lo.d), 1⟩ &&
      c.a.lo.n / (Int.ofNat c.a.lo.d) == c.a.hi.n / (Int.ofNat c.a.hi.d)
  | .lt => (lt c.a.hi c.b.lo && singleton c.result one) ||
      (le c.b.hi c.a.lo && singleton c.result zero)
  | .le => (le c.a.hi c.b.lo && singleton c.result one) ||
      (lt c.b.hi c.a.lo && singleton c.result zero)
  | .eq => (eq c.a.lo c.a.hi && eq c.b.lo c.b.hi && eq c.a.lo c.b.lo && singleton c.result one) ||
      ((lt c.a.hi c.b.lo || lt c.b.hi c.a.lo) && singleton c.result zero)
  | .truth => ((lt c.a.hi zero || lt zero c.a.lo) && singleton c.result one) ||
      (singleton c.a zero && singleton c.result zero)

def checkBlock (cs : List Constraint) : Bool := cs.all check
def allPositive (states : List Box) : Bool := states.all (fun b => valid b && lt zero b.lo)
end Composed

-- This file is concatenated after composed_checker.lean by the certificate
-- exporter. The statements quantify over all rational inputs, not test cases.
namespace Composed

def QLe (a b : Q) : Prop := a.n * (b.d : Int) ≤ b.n * (a.d : Int)
def QPos (a : Q) : Prop := 0 < a.d
def InBox (b : Box) (x : Q) : Prop := QPos x ∧ QLe b.lo x ∧ QLe x b.hi
instance (a b : Q) : Decidable (QLe a b) :=
  inferInstanceAs (Decidable (a.n * (b.d : Int) ≤ b.n * (a.d : Int)))
instance (a : Q) : Decidable (QPos a) := inferInstanceAs (Decidable (0 < a.d))
instance (b : Box) (x : Q) : Decidable (InBox b x) :=
  inferInstanceAs (Decidable (QPos x ∧ QLe b.lo x ∧ QLe x b.hi))

theorem qle_trans {a b c : Q} (hb : QPos b)
    (hab : QLe a b) (hbc : QLe b c) : QLe a c := by
  have h1 := Int.mul_le_mul_of_nonneg_right hab (Int.natCast_nonneg c.d)
  have h2 := Int.mul_le_mul_of_nonneg_right hbc (Int.natCast_nonneg a.d)
  have hp : (0 : Int) < b.d := by exact_mod_cast hb
  apply Int.le_of_mul_le_mul_right (a := (b.d : Int)) (h := hp)
  simp only [QLe] at hab hbc ⊢
  simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] at h1 h2 ⊢
  omega

theorem qle_add {a b x y : Q} (hax : QLe a x) (hby : QLe b y) :
    QLe (add a b) (add x y) := by
  have h1 := Int.mul_le_mul_of_nonneg_right hax (Int.mul_nonneg (Int.natCast_nonneg b.d) (Int.natCast_nonneg y.d))
  have h2 := Int.mul_le_mul_of_nonneg_right hby (Int.mul_nonneg (Int.natCast_nonneg a.d) (Int.natCast_nonneg x.d))
  simp only [QLe, add, Int.natCast_mul] at h1 h2 ⊢
  simp only [Int.add_mul, Int.mul_add, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] at h1 h2 ⊢
  omega

theorem qle_neg {a b : Q} (hab : QLe a b) : QLe (neg b) (neg a) := by
  simp only [QLe, neg, Int.neg_mul] at hab ⊢
  omega

theorem add_positive {a b : Q} (ha : QPos a) (hb : QPos b) : QPos (add a b) := by
  exact Nat.mul_pos ha hb

theorem check_add_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.add, a, b, r⟩ = true)
    (hx : InBox a x) (hy : InBox b y) : InBox r (add x y) := by
  simp only [check, valid, le, Bool.and_eq_true, decide_eq_true_eq] at checked
  rcases hx with ⟨hxp, hxl, hxu⟩
  rcases hy with ⟨hyp, hyl, hyu⟩
  have alo : QPos a.lo := by simp_all [QPos]
  have blo : QPos b.lo := by simp_all [QPos]
  have ahi : QPos a.hi := by simp_all [QPos]
  have bhi : QPos b.hi := by simp_all [QPos]
  have lower : QLe r.lo (add a.lo b.lo) := by simp_all [QLe]
  have upper : QLe (add a.hi b.hi) r.hi := by simp_all [QLe]
  exact ⟨add_positive hxp hyp,
    qle_trans (add_positive alo blo) lower (qle_add hxl hyl),
    qle_trans (add_positive ahi bhi) (qle_add hxu hyu) upper⟩

theorem check_neg_sound (a b r : Box) (x : Q)
    (checked : check ⟨.neg, a, b, r⟩ = true)
    (hx : InBox a x) : InBox r (neg x) := by
  simp only [check, valid, le, Bool.and_eq_true, decide_eq_true_eq] at checked
  rcases hx with ⟨hxp, hxl, hxu⟩
  have ahi : QPos (neg a.hi) := by simp_all [QPos, neg]
  have alo : QPos (neg a.lo) := by simp_all [QPos, neg]
  have lower : QLe r.lo (neg a.hi) := by simp_all [QLe]
  have upper : QLe (neg a.lo) r.hi := by simp_all [QLe]
  exact ⟨hxp, qle_trans ahi lower (qle_neg hxu),
    qle_trans alo (qle_neg hxl) upper⟩

theorem check_sub_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.sub, a, b, r⟩ = true)
    (hx : InBox a x) (hy : InBox b y) : InBox r (sub x y) := by
  simp only [check, valid, le, Bool.and_eq_true, decide_eq_true_eq] at checked
  rcases hx with ⟨hxp, hxl, hxu⟩
  rcases hy with ⟨hyp, hyl, hyu⟩
  have alo : QPos a.lo := by simp_all [QPos]
  have blo : QPos (neg b.lo) := by simp_all [QPos, neg]
  have ahi : QPos a.hi := by simp_all [QPos]
  have bhi : QPos (neg b.hi) := by simp_all [QPos, neg]
  have lower : QLe r.lo (sub a.lo b.hi) := by simp_all [QLe]
  have upper : QLe (sub a.hi b.lo) r.hi := by simp_all [QLe]
  exact ⟨add_positive hxp hyp,
    qle_trans (add_positive alo bhi) lower (qle_add hxl (qle_neg hyu)),
    qle_trans (add_positive ahi blo) (qle_add hxu (qle_neg hyl)) upper⟩

def qmin (a b : Q) : Q := if le a b then a else b
def qmax (a b : Q) : Q := if le a b then b else a

theorem qmin_positive {a b : Q} (ha : QPos a) (hb : QPos b) : QPos (qmin a b) := by
  unfold qmin; split <;> assumption
theorem qmax_positive {a b : Q} (ha : QPos a) (hb : QPos b) : QPos (qmax a b) := by
  unfold qmax; split <;> assumption
theorem qmin_le_left (a b : Q) : QLe (qmin a b) a := by
  unfold qmin; split <;> simp_all [le, QLe] <;> omega
theorem qmin_le_right (a b : Q) : QLe (qmin a b) b := by
  unfold qmin; split <;> simp_all [le, QLe] <;> omega
theorem qmax_ge_left (a b : Q) : QLe a (qmax a b) := by
  unfold qmax; split <;> simp_all [le, QLe] <;> omega
theorem qmax_ge_right (a b : Q) : QLe b (qmax a b) := by
  unfold qmax; split <;> simp_all [le, QLe] <;> omega
theorem qmin_lower {a b x : Q} (ha : QLe x a) (hb : QLe x b) : QLe x (qmin a b) := by
  unfold qmin; split <;> assumption
theorem qmin_upper {a b x : Q} (ha : QLe a x) (hb : QLe b x) : QLe (qmin a b) x := by
  unfold qmin; split <;> assumption
theorem qmax_lower {a b x : Q} (ha : QLe x a) (hb : QLe x b) : QLe x (qmax a b) := by
  unfold qmax; split <;> assumption
theorem qmax_upper {a b x : Q} (ha : QLe a x) (hb : QLe b x) : QLe (qmax a b) x := by
  unfold qmax; split <;> assumption

theorem qmin_mono {a b x y : Q} (ha : QPos a) (hb : QPos b)
    (_hx : QPos x) (_hy : QPos y) (hax : QLe a x) (hby : QLe b y) :
    QLe (qmin a b) (qmin x y) := by
  exact qmin_lower (qle_trans ha (qmin_le_left a b) hax)
    (qle_trans hb (qmin_le_right a b) hby)

theorem qmax_mono {a b x y : Q} (_ha : QPos a) (_hb : QPos b)
    (hx : QPos x) (hy : QPos y) (hax : QLe a x) (hby : QLe b y) :
    QLe (qmax a b) (qmax x y) := by
  exact qmax_upper (qle_trans hx hax (qmax_ge_left x y))
    (qle_trans hy hby (qmax_ge_right x y))

theorem check_min_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.min, a, b, r⟩ = true)
    (hx : InBox a x) (hy : InBox b y) : InBox r (qmin x y) := by
  simp only [check, valid, le, Bool.and_eq_true, decide_eq_true_eq] at checked
  rcases hx with ⟨hxp, hxl, hxu⟩
  rcases hy with ⟨hyp, hyl, hyu⟩
  have alo : QPos a.lo := by simp_all [QPos]
  have blo : QPos b.lo := by simp_all [QPos]
  have ahi : QPos a.hi := by simp_all [QPos]
  have bhi : QPos b.hi := by simp_all [QPos]
  have lower : QLe r.lo (qmin a.lo b.lo) := by simp_all [QLe, qmin, le]
  have upper : QLe (qmin a.hi b.hi) r.hi := by simp_all [QLe, qmin, le]
  exact ⟨qmin_positive hxp hyp,
    qle_trans (qmin_positive alo blo) lower (qmin_mono alo blo hxp hyp hxl hyl),
    qle_trans (qmin_positive ahi bhi) (qmin_mono hxp hyp ahi bhi hxu hyu) upper⟩

theorem check_max_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.max, a, b, r⟩ = true)
    (hx : InBox a x) (hy : InBox b y) : InBox r (qmax x y) := by
  simp only [check, valid, le, Bool.and_eq_true, decide_eq_true_eq] at checked
  rcases hx with ⟨hxp, hxl, hxu⟩
  rcases hy with ⟨hyp, hyl, hyu⟩
  have alo : QPos a.lo := by simp_all [QPos]
  have blo : QPos b.lo := by simp_all [QPos]
  have ahi : QPos a.hi := by simp_all [QPos]
  have bhi : QPos b.hi := by simp_all [QPos]
  have lower : QLe r.lo (qmax a.lo b.lo) := by simp_all [QLe, qmax, le]
  have upper : QLe (qmax a.hi b.hi) r.hi := by simp_all [QLe, qmax, le]
  exact ⟨qmax_positive hxp hyp,
    qle_trans (qmax_positive alo blo) lower (qmax_mono alo blo hxp hyp hxl hyl),
    qle_trans (qmax_positive ahi bhi) (qmax_mono hxp hyp ahi bhi hxu hyu) upper⟩

theorem mul_positive {a b : Q} (ha : QPos a) (hb : QPos b) : QPos (mul a b) := by
  exact Nat.mul_pos ha hb

theorem mul_comm (a b : Q) : mul a b = mul b a := by
  cases a; cases b; simp [mul, Int.mul_comm, Nat.mul_comm]

theorem qle_mul_nonneg {a b c : Q} (hab : QLe a b) (hc : 0 ≤ c.n) :
    QLe (mul a c) (mul b c) := by
  have h := Int.mul_le_mul_of_nonneg_right hab (Int.mul_nonneg hc (Int.natCast_nonneg c.d))
  simp only [QLe, mul, Int.natCast_mul] at h ⊢
  simpa only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] using h

theorem qle_mul_nonpos {a b c : Q} (hab : QLe a b) (hc : c.n ≤ 0) :
    QLe (mul b c) (mul a c) := by
  have h := Int.mul_le_mul_of_nonpos_right hab (Int.mul_nonpos_of_nonpos_of_nonneg hc (Int.natCast_nonneg c.d))
  simp only [QLe, mul, Int.natCast_mul] at h ⊢
  simpa only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] using h

theorem fixed_mul_enclosure (a r : Box) (x c : Q)
    (alo : QPos a.lo) (ahi : QPos a.hi) (hc : QPos c) (hx : InBox a x)
    (ll : QLe r.lo (mul a.lo c)) (lh : QLe r.lo (mul a.hi c))
    (ul : QLe (mul a.lo c) r.hi) (uh : QLe (mul a.hi c) r.hi) :
    InBox r (mul x c) := by
  rcases hx with ⟨xp, xl, xu⟩
  by_cases hn : 0 ≤ c.n
  · exact ⟨mul_positive xp hc,
      qle_trans (mul_positive alo hc) ll (qle_mul_nonneg xl hn),
      qle_trans (mul_positive ahi hc) (qle_mul_nonneg xu hn) uh⟩
  · have hn' : c.n ≤ 0 := by omega
    exact ⟨mul_positive xp hc,
      qle_trans (mul_positive ahi hc) lh (qle_mul_nonpos xu hn'),
      qle_trans (mul_positive alo hc) (qle_mul_nonpos xl hn') ul⟩

theorem check_mul_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.mul, a, b, r⟩ = true)
    (hx : InBox a x) (hy : InBox b y) : InBox r (mul x y) := by
  simp only [check, valid, List.all_cons, List.all_nil, contains, le,
    Bool.and_eq_true, decide_eq_true_eq] at checked
  have alo : QPos a.lo := by simp_all [QPos]
  have ahi : QPos a.hi := by simp_all [QPos]
  have blo : QPos b.lo := by simp_all [QPos]
  have bhi : QPos b.hi := by simp_all [QPos]
  have low : InBox r (mul x b.lo) := by
    apply fixed_mul_enclosure a r x b.lo alo ahi blo hx <;> simp_all [QLe]
  have high : InBox r (mul x b.hi) := by
    apply fixed_mul_enclosure a r x b.hi alo ahi bhi hx <;> simp_all [QLe]
  rcases hx with ⟨xp, xl, xu⟩
  rcases hy with ⟨yp, yl, yu⟩
  by_cases hn : 0 ≤ x.n
  · have lower : QLe (mul x b.lo) (mul x y) := by
      simpa only [mul_comm] using qle_mul_nonneg (c := x) yl hn
    have upper : QLe (mul x y) (mul x b.hi) := by
      simpa only [mul_comm] using qle_mul_nonneg (c := x) yu hn
    exact ⟨mul_positive xp yp, qle_trans low.1 low.2.1 lower,
      qle_trans high.1 upper high.2.2⟩
  · have hn' : x.n ≤ 0 := by omega
    have lower : QLe (mul x b.hi) (mul x y) := by
      simpa only [mul_comm] using qle_mul_nonpos (c := x) yu hn'
    have upper : QLe (mul x y) (mul x b.lo) := by
      simpa only [mul_comm] using qle_mul_nonpos (c := x) yl hn'
    exact ⟨mul_positive xp yp, qle_trans high.1 high.2.1 lower,
      qle_trans low.1 upper low.2.2⟩

theorem check_constant_sound (a b r : Box) (q : Q)
    (checked : check ⟨.constant q, a, b, r⟩ = true) : InBox r q := by
  simp only [check, valid, singleton, eq, le, Bool.and_eq_true,
    decide_eq_true_eq, beq_iff_eq] at checked
  constructor
  · simp_all [QPos]
  · constructor <;> simp_all [QLe] <;> omega

theorem checked_positive_sound (b : Box) (x : Q)
    (checked : valid b && lt zero b.lo = true) (hx : InBox b x) :
    QPos x ∧ 0 < x.n := by
  simp only [valid, lt, le, zero, Bool.and_eq_true, decide_eq_true_eq,
    Int.zero_mul] at checked
  rcases hx with ⟨xp, xl, xu⟩
  have lop : (0 : Int) < b.lo.n := by simp_all
  have xdp : (0 : Int) < x.d := by exact_mod_cast xp
  have product_pos := Int.mul_pos lop xdp
  have rhs_pos : 0 < x.n * (b.lo.d : Int) := by
    simp only [QLe] at xl
    omega
  constructor
  · exact xp
  · by_cases h : 0 < x.n
    · exact h
    · have hn : x.n ≤ 0 := by omega
      have bad := Int.mul_nonpos_of_nonpos_of_nonneg hn (Int.natCast_nonneg b.lo.d)
      omega

end Composed

-- Concatenate after composed_checker.lean and interval_soundness.lean.
namespace Composed

def QLt (a b : Q) : Prop := a.n * (b.d : Int) < b.n * (a.d : Int)
def QEq (a b : Q) : Prop := a.n * (b.d : Int) = b.n * (a.d : Int)
instance (a b : Q) : Decidable (QLt a b) := inferInstanceAs (Decidable (a.n * (b.d : Int) < b.n * (a.d : Int)))
instance (a b : Q) : Decidable (QEq a b) := inferInstanceAs (Decidable (a.n * (b.d : Int) = b.n * (a.d : Int)))
def qbool (p : Bool) : Q := if p then one else zero
def qfloor (x : Q) : Q := ⟨x.n / (x.d : Int), 1⟩

theorem qle_lt_trans {a b c : Q} (ha : QPos a) (_hb : QPos b)
    (hab : QLe a b) (hbc : QLt b c) : QLt a c := by
  have ap : (0 : Int) < a.d := by exact_mod_cast ha
  have bp : (0 : Int) ≤ b.d := Int.natCast_nonneg _
  have h1 := Int.mul_le_mul_of_nonneg_right hab (Int.natCast_nonneg c.d)
  have h2 := Int.mul_lt_mul_of_pos_right hbc ap
  apply Int.lt_of_mul_lt_mul_right (a := (b.d : Int)) (h := bp)
  simp only [QLt] at hbc ⊢
  simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] at h1 h2 ⊢
  omega

theorem qlt_le_trans {a b c : Q} (_hb : QPos b) (hc : QPos c)
    (hab : QLt a b) (hbc : QLe b c) : QLt a c := by
  have cp : (0 : Int) < c.d := by exact_mod_cast hc
  have h1 := Int.mul_lt_mul_of_pos_right hab cp
  have h2 := Int.mul_le_mul_of_nonneg_right hbc (Int.natCast_nonneg a.d)
  apply Int.lt_of_mul_lt_mul_right (a := (b.d : Int)) (h := Int.natCast_nonneg _)
  simp only [QLt] at hab ⊢
  simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm] at h1 h2 ⊢
  omega

theorem qeq_le {a b : Q} (h : QEq a b) : QLe a b := by simp_all [QEq, QLe]
theorem qeq_symm {a b : Q} (h : QEq a b) : QEq b a := by simp_all [QEq]
theorem qeq_of_le {a b : Q} (h1 : QLe a b) (h2 : QLe b a) : QEq a b := by
  simp only [QEq, QLe] at *; omega
theorem singleton_sound (r : Box) (x : Q) (hp : QPos x)
    (h : singleton r x = true) : InBox r x := by
  simp only [singleton, eq, Bool.and_eq_true, beq_iff_eq] at h
  exact ⟨hp, by simp_all [QLe], by simp_all [QLe]⟩

theorem floor_mono {a b : Q} (ha : QPos a) (hb : QPos b) (h : QLe a b) :
    a.n / (a.d : Int) ≤ b.n / (b.d : Int) := by
  have ap : (0 : Int) < a.d := by exact_mod_cast ha
  have bp : (0 : Int) < b.d := by exact_mod_cast hb
  have bound : QLe (qfloor a) a := by
    simpa [QLe, qfloor] using Int.ediv_mul_le a.n (by omega : (a.d : Int) ≠ 0)
  have next := qle_trans ha bound h
  apply Int.le_ediv_of_mul_le bp
  simpa [QLe, qfloor] using next

theorem check_floor_sound (a b r : Box) (x : Q)
    (checked : check ⟨.floor, a, b, r⟩ = true) (hx : InBox a x) :
    InBox r (qfloor x) := by
  have alo : QPos a.lo := by simp_all [check, valid, QPos]
  have ahi : QPos a.hi := by simp_all [check, valid, QPos]
  have same : a.lo.n / (a.lo.d : Int) = a.hi.n / (a.hi.d : Int) := by
    simp_all [check, valid, beq_iff_eq]
  have sl : singleton r (qfloor a.lo) = true := by simp_all [check, qfloor]
  have lower := floor_mono alo hx.1 hx.2.1
  have upper := floor_mono hx.1 ahi hx.2.2
  have samex : qfloor x = qfloor a.lo := by
    unfold qfloor; congr 1; omega
  rw [samex]
  exact singleton_sound r _ (by simp [QPos, qfloor]) sl

theorem separated_lt (a b : Box) (x y : Q)
    (hx : InBox a x) (hy : InBox b y)
    (ahi : QPos a.hi) (blo : QPos b.lo) (h : QLt a.hi b.lo) : QLt x y :=
  qlt_le_trans blo hy.1 (qle_lt_trans hx.1 ahi hx.2.2 h) hy.2.1

theorem separated_le (a b : Box) (x y : Q)
    (hx : InBox a x) (hy : InBox b y)
    (ahi : QPos a.hi) (blo : QPos b.lo) (h : QLe a.hi b.lo) : QLe x y :=
  qle_trans blo (qle_trans ahi hx.2.2 h) hy.2.1

theorem check_lt_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.lt, a, b, r⟩ = true) (hx : InBox a x) (hy : InBox b y) :
    InBox r (qbool (lt x y)) := by
  have ahi : QPos a.hi := by simp_all [check, valid, QPos]
  have alo : QPos a.lo := by simp_all [check, valid, QPos]
  have bhi : QPos b.hi := by simp_all [check, valid, QPos]
  have blo : QPos b.lo := by simp_all [check, valid, QPos]
  have cases : (QLt a.hi b.lo ∧ singleton r one = true) ∨
      (QLe b.hi a.lo ∧ singleton r zero = true) := by
    simp_all [check, valid, lt, le, QLt, QLe]
  rcases cases with h | h
  · have hxy := separated_lt a b x y hx hy ahi blo h.1
    have flag : lt x y = true := by simpa [lt, QLt] using hxy
    simp only [qbool, flag] 
    exact singleton_sound r one (by decide) h.2
  · have hyx := separated_le b a y x hy hx bhi alo h.1
    have flag : lt x y = false := by simp [lt, QLe] at *; omega
    simp only [qbool, flag]
    exact singleton_sound r zero (by decide) h.2

theorem check_le_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.le, a, b, r⟩ = true) (hx : InBox a x) (hy : InBox b y) :
    InBox r (qbool (le x y)) := by
  have ahi : QPos a.hi := by simp_all [check, valid, QPos]
  have alo : QPos a.lo := by simp_all [check, valid, QPos]
  have bhi : QPos b.hi := by simp_all [check, valid, QPos]
  have blo : QPos b.lo := by simp_all [check, valid, QPos]
  have cases : (QLe a.hi b.lo ∧ singleton r one = true) ∨
      (QLt b.hi a.lo ∧ singleton r zero = true) := by
    simp_all [check, valid, lt, le, QLt, QLe]
  rcases cases with h | h
  · have hxy := separated_le a b x y hx hy ahi blo h.1
    have flag : le x y = true := by simpa [le, QLe] using hxy
    simp only [qbool, flag]
    exact singleton_sound r one (by decide) h.2
  · have hyx := separated_lt b a y x hy hx bhi alo h.1
    have flag : le x y = false := by simp [le, QLt] at *; omega
    simp only [qbool, flag]
    exact singleton_sound r zero (by decide) h.2

theorem qeq_trans {a b c : Q} (hb : QPos b) (h1 : QEq a b) (h2 : QEq b c) : QEq a c :=
  qeq_of_le (qle_trans hb (qeq_le h1) (qeq_le h2))
    (qle_trans hb (qeq_le (qeq_symm h2)) (qeq_le (qeq_symm h1)))

theorem singleton_value (a : Box) (x v : Q) (alo : QPos a.lo) (ahi : QPos a.hi)
    (hx : InBox a x) (h : singleton a v = true) : QEq x v := by
  have h1 : QEq a.lo v := by simp_all [singleton, eq, QEq]
  have h2 : QEq a.hi v := by simp_all [singleton, eq, QEq]
  exact qeq_of_le (qle_trans ahi hx.2.2 (qeq_le h2))
    (qle_trans alo (qeq_le (qeq_symm h1)) hx.2.1)

theorem check_eq_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.eq, a, b, r⟩ = true) (hx : InBox a x) (hy : InBox b y) :
    InBox r (qbool (eq x y)) := by
  have ahi : QPos a.hi := by simp_all [check, valid, QPos]
  have alo : QPos a.lo := by simp_all [check, valid, QPos]
  have bhi : QPos b.hi := by simp_all [check, valid, QPos]
  have blo : QPos b.lo := by simp_all [check, valid, QPos]
  have cases : (QEq a.lo a.hi ∧ QEq b.lo b.hi ∧ QEq a.lo b.lo ∧ singleton r one = true) ∨
      ((QLt a.hi b.lo ∨ QLt b.hi a.lo) ∧ singleton r zero = true) := by
    simp_all [check, valid, lt, le, eq, QLt, QEq, and_assoc]
  rcases cases with h | h
  · have sa : singleton a a.lo = true := by simp_all [singleton, eq, QEq]
    have sb : singleton b b.lo = true := by simp_all [singleton, eq, QEq]
    have xv := singleton_value a x a.lo alo ahi hx sa
    have yv := singleton_value b y b.lo blo bhi hy sb
    have xy := qeq_trans blo (qeq_trans alo xv h.2.2.1) (qeq_symm yv)
    have flag : eq x y = true := by simpa [eq, QEq] using xy
    simp only [qbool, flag]
    exact singleton_sound r one (by decide) h.2.2.2
  · have flag : eq x y = false := by
      rcases h.1 with sep | sep
      · have xy := separated_lt a b x y hx hy ahi blo sep
        simp [eq, QLt] at *; omega
      · have yx := separated_lt b a y x hy hx bhi alo sep
        simp [eq, QLt] at *; omega
    simp only [qbool, flag]
    exact singleton_sound r zero (by decide) h.2

def qtruth (x : Q) : Q := if x.n = 0 then zero else one

theorem check_truth_sound (a b r : Box) (x : Q)
    (checked : check ⟨.truth, a, b, r⟩ = true) (hx : InBox a x) :
    InBox r (qtruth x) := by
  have ahi : QPos a.hi := by simp_all [check, valid, QPos]
  have alo : QPos a.lo := by simp_all [check, valid, QPos]
  have cases : ((QLt a.hi zero ∨ QLt zero a.lo) ∧ singleton r one = true) ∨
      (singleton a zero = true ∧ singleton r zero = true) := by
    simp_all [check, valid, lt, le, QLt, QLe]
  rcases cases with h | h
  · have hn : x.n ≠ 0 := by
      rcases h.1 with below | above
      · have bound := qle_lt_trans hx.1 ahi hx.2.2 below
        simp [QLt, zero] at bound; omega
      · have bound := qlt_le_trans alo hx.1 above hx.2.1
        simp [QLt, zero] at bound; omega
    simp only [qtruth, hn, ↓reduceIte]
    exact singleton_sound r one (by decide) h.2
  · have value := singleton_value a x zero alo ahi hx h.1
    have hn : x.n = 0 := by simpa [QEq, zero] using value
    simp only [qtruth, hn, ↓reduceIte]
    exact singleton_sound r zero (by decide) h.2

def recip (q : Q) : Q :=
  if q.n < 0 then ⟨-(q.d : Int), q.n.natAbs⟩ else ⟨q.d, q.n.natAbs⟩

theorem recip_positive {q : Q} (h : q.n ≠ 0) : QPos (recip q) := by
  unfold QPos recip; split <;> exact Int.natAbs_pos.mpr h

theorem div_as_mul (a b : Q) : div a b = mul a (recip b) := by
  unfold div recip mul; split <;> simp_all [Int.mul_neg, Int.neg_mul]

theorem recip_antitone_pos (a b : Q) (ha : 0 < a.n) (hb : 0 < b.n)
    (h : QLe a b) : QLe (recip b) (recip a) := by
  have an := Int.natAbs_of_nonneg (by omega : 0 ≤ a.n)
  have bn := Int.natAbs_of_nonneg (by omega : 0 ≤ b.n)
  have ra : recip a = ⟨a.d, a.n.natAbs⟩ := by
    unfold recip; exact if_neg (by omega)
  have rb : recip b = ⟨b.d, b.n.natAbs⟩ := by
    unfold recip; exact if_neg (by omega)
  rw [ra, rb]
  change (b.d : Int) * (a.n.natAbs : Int) ≤ (a.d : Int) * (b.n.natAbs : Int)
  rw [an, bn]
  simp only [QLe] at h
  simpa only [Int.mul_comm] using h

theorem recip_antitone_neg (a b : Q) (ha : a.n < 0) (hb : b.n < 0)
    (h : QLe a b) : QLe (recip b) (recip a) := by
  have an := Int.ofNat_natAbs_of_nonpos (by omega : a.n ≤ 0)
  have bn := Int.ofNat_natAbs_of_nonpos (by omega : b.n ≤ 0)
  simp only [QLe] at h
  simpa [QLe, recip, ha, hb, an, bn, Int.mul_comm, Int.neg_mul, Int.mul_neg] using h

theorem inverse_box_sound (b : Box) (y : Q) (hy : InBox b y)
    (bp : QPos b.lo) (bq : QPos b.hi)
    (side : QLt b.hi zero ∨ QLt zero b.lo) :
    InBox ⟨recip b.hi, recip b.lo⟩ (recip y) := by
  rcases side with negative | positive
  · have hn : b.hi.n < 0 := by simpa [QLt, zero] using negative
    have yn : y.n < 0 := by
      have h := qle_lt_trans hy.1 bq hy.2.2 negative
      simpa [QLt, zero] using h
    have ln : b.lo.n < 0 := by
      have h := qle_lt_trans bp hy.1 hy.2.1 (show QLt y zero from by simpa [QLt, zero] using yn)
      simpa [QLt, zero] using h
    exact ⟨recip_positive (by omega),
      recip_antitone_neg y b.hi yn hn hy.2.2,
      recip_antitone_neg b.lo y ln yn hy.2.1⟩
  · have ln : 0 < b.lo.n := by simpa [QLt, zero] using positive
    have yn : 0 < y.n := by
      have h := qlt_le_trans bp hy.1 positive hy.2.1
      simpa [QLt, zero] using h
    have hn : 0 < b.hi.n := by
      have h := qlt_le_trans hy.1 bq (show QLt zero y from by simpa [QLt, zero] using yn) hy.2.2
      simpa [QLt, zero] using h
    exact ⟨recip_positive (by omega),
      recip_antitone_pos y b.hi yn hn hy.2.2,
      recip_antitone_pos b.lo y ln yn hy.2.1⟩

theorem check_div_sound (a b r : Box) (x y : Q)
    (checked : check ⟨.div, a, b, r⟩ = true) (hx : InBox a x) (hy : InBox b y) :
    InBox r (div x y) := by
  have bp : QPos b.lo := by simp_all [check, valid, QPos]
  have bq : QPos b.hi := by simp_all [check, valid, QPos]
  have bbound : QLe b.lo b.hi := by simp_all [check, valid, QLe, le]
  have side : QLt b.hi zero ∨ QLt zero b.lo := by simp_all [check, valid, QLt, lt]
  have inverse := inverse_box_sound b y hy bp bq side
  have ln : b.lo.n ≠ 0 := by
    rcases side with h | h
    · have neg := qle_lt_trans bp bq bbound h
      simp [QLt, zero] at neg; omega
    · simp [QLt, zero] at h; omega
  have hn : b.hi.n ≠ 0 := by
    rcases side with h | h
    · simp [QLt, zero] at h; omega
    · have pos := qlt_le_trans bp bq h bbound
      simp [QLt, zero] at pos; omega
  have invbound : QLe (recip b.hi) (recip b.lo) := by
    rcases side with h | h
    · have low := qle_lt_trans bp bq bbound h
      apply recip_antitone_neg b.lo b.hi <;> simp_all [QLt, zero]
    · have high := qlt_le_trans bp bq h bbound
      apply recip_antitone_pos b.lo b.hi <;> simp_all [QLt, zero]
  have iv : valid ⟨recip b.hi, recip b.lo⟩ = true := by
    have h1 := recip_positive ln
    have h2 := recip_positive hn
    simp_all [valid, QPos, QLe, le]
  have mc : check ⟨.mul, a, ⟨recip b.hi, recip b.lo⟩, r⟩ = true := by
    simp_all [check, div_as_mul, List.all_cons, List.all_nil, and_assoc]
  rw [div_as_mul]
  exact check_mul_sound a _ r x _ mc hx inverse

def evalOp : Op → Q → Q → Q
  | .constant q, _, _ => q
  | .add, x, y => add x y
  | .sub, x, y => sub x y
  | .mul, x, y => mul x y
  | .div, x, y => div x y
  | .min, x, y => qmin x y
  | .max, x, y => qmax x y
  | .floor, x, _ => qfloor x
  | .lt, x, y => qbool (lt x y)
  | .le, x, y => qbool (le x y)
  | .eq, x, y => qbool (eq x y)
  | .truth, x, _ => qtruth x
  | .neg, x, _ => neg x

theorem check_sound (op : Op) (a b r : Box) (x y : Q)
    (checked : check ⟨op, a, b, r⟩ = true) (hx : InBox a x) (hy : InBox b y) :
    InBox r (evalOp op x y) := by
  cases op with
  | constant q => exact check_constant_sound a b r q checked
  | add => exact check_add_sound a b r x y checked hx hy
  | sub => exact check_sub_sound a b r x y checked hx hy
  | mul => exact check_mul_sound a b r x y checked hx hy
  | div => exact check_div_sound a b r x y checked hx hy
  | min => exact check_min_sound a b r x y checked hx hy
  | max => exact check_max_sound a b r x y checked hx hy
  | floor => exact check_floor_sound a b r x checked hx
  | lt => exact check_lt_sound a b r x y checked hx hy
  | le => exact check_le_sound a b r x y checked hx hy
  | eq => exact check_eq_sound a b r x y checked hx hy
  | truth => exact check_truth_sound a b r x checked hx
  | neg => exact check_neg_sound a b r x checked hx

end Composed


namespace WorldExpression

-- Parameterized semantics: correctness does not depend on particular numeric inputs.
structure Algebra (V : Type) where
  literal : Int → Nat → V
  add : V → V → V
  sub : V → V → V
  mul : V → V → V
  div : V → V → V
  min : V → V → V
  max : V → V → V
  lt : V → V → V
  le : V → V → V
  eq : V → V → V
  truth : V → V

inductive Bin where
  | add | sub | mul | div | min | max | lt | le | eq | and | or
  deriving BEq, DecidableEq
inductive Expr where
  | lit (n : Int) (d : Nat)
  | var (name : String)
  | binary (op : Bin) (a b : Expr)
  | gt (a b : Expr)
  | ge (a b : Expr)
  | clamp (a lo hi : Expr)
  | not (a : Expr)
  | truth (a : Expr)
  | power (a : Expr) (n : Nat)
  deriving BEq, DecidableEq
inductive Term where
  | lit (n : Int) (d : Nat)
  | var (name : String)
  | binary (op : Bin) (a b : Term)
  | truth (a : Term)
  deriving BEq, DecidableEq

def binary (s : Algebra V) : Bin → V → V → V
  | .add => s.add | .sub => s.sub | .mul => s.mul | .div => s.div
  | .min => s.min | .max => s.max | .lt => s.lt | .le => s.le | .eq => s.eq
  | .and => fun a b => s.min (s.truth a) (s.truth b)
  | .or => fun a b => s.max (s.truth a) (s.truth b)

def repeated (s : Algebra V) (a : V) : Nat → V
  | 0 => s.literal 1 1
  | n+1 => s.mul (repeated s a n) a
def repeatTerm (a : Term) : Nat → Term
  | 0 => .lit 1 1
  | n+1 => .binary .mul (repeatTerm a n) a
def evalTerm (s : Algebra V) (env : String → V) : Term → V
  | .lit n d => s.literal n d
  | .var x => env x
  | .binary op a b => binary s op (evalTerm s env a) (evalTerm s env b)
  | .truth a => s.truth (evalTerm s env a)
def evalExpr (s : Algebra V) (env : String → V) : Expr → V
  | .lit n d => s.literal n d
  | .var x => env x
  | .binary op a b => binary s op (evalExpr s env a) (evalExpr s env b)
  | .gt a b => s.lt (evalExpr s env b) (evalExpr s env a)
  | .ge a b => s.le (evalExpr s env b) (evalExpr s env a)
  | .clamp a lo hi => s.min (evalExpr s env hi) (s.max (evalExpr s env lo) (evalExpr s env a))
  | .not a => s.sub (s.literal 1 1) (s.truth (evalExpr s env a))
  | .truth a => s.truth (evalExpr s env a)
  | .power a n => repeated s (evalExpr s env a) n
def lower : Expr → Term
  | .lit n d => .lit n d
  | .var x => .var x
  | .binary op a b => match op with
    | .and => .binary .min (.truth (lower a)) (.truth (lower b))
    | .or => .binary .max (.truth (lower a)) (.truth (lower b))
    | other => .binary other (lower a) (lower b)
  | .gt a b => .binary .lt (lower b) (lower a)
  | .ge a b => .binary .le (lower b) (lower a)
  | .clamp a lo hi => .binary .min (lower hi) (.binary .max (lower lo) (lower a))
  | .not a => .binary .sub (.lit 1 1) (.truth (lower a))
  | .truth a => .truth (lower a)
  | .power a n => repeatTerm (lower a) n

theorem repeat_correct (s : Algebra V) (env : String → V) (a : Term) (n : Nat) :
    evalTerm s env (repeatTerm a n) = repeated s (evalTerm s env a) n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [repeatTerm, evalTerm, binary, repeated, ih]

theorem compile_correct (s : Algebra V) (env : String → V) (e : Expr) :
    evalTerm s env (lower e) = evalExpr s env e := by
  induction e with
  | lit n d => rfl
  | var x => rfl
  | binary op a b ia ib => cases op <;> simp [lower, evalTerm, evalExpr, binary, ia, ib]
  | gt a b ia ib => simp [lower, evalTerm, evalExpr, binary, ia, ib]
  | ge a b ia ib => simp [lower, evalTerm, evalExpr, binary, ia, ib]
  | clamp a lo hi ia il ih => simp [lower, evalTerm, evalExpr, binary, ia, il, ih]
  | not a ia => simp [lower, evalTerm, evalExpr, binary, ia]
  | truth a ia => simp [lower, evalTerm, evalExpr, ia]
  | power a n ia => simp [lower, evalExpr, repeat_correct, ia]

theorem checked_compilation_correct (s : Algebra V) (env : String → V)
    (e : Expr) (t : Term) (checked : t = lower e) :
    evalTerm s env t = evalExpr s env e := by
  rw [checked]
  exact compile_correct s env e
end WorldExpression

